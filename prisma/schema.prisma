generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  type      String   // "profiles" | "bolts" | "welds" | "cad"
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@map("projects")
}

model Favorite {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  designation String   // e.g. "W14x30", "SHS 100×100×5"
  profileType String   @map("profile_type") // e.g. "W", "SHS", "CHS"
  standard    String   // "AISC" | "EN"
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([userId, designation])
  @@map("favorites")
}
